entrypoint = "README.md"
modules = ["nodejs-22", "python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["jdk", "android-tools"]

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "cd /home/runner/workspace && npx npm install sharp && npm run server:build"]
run = ["bash", "-c", "NODE_ENV=production node server_dist/index.js"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8081
externalPort = 80

[env]
PORT = "5000"

[agent]
stack = "EXPO"
integrations = ["github:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run server:dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run expo:dev"
waitForPort = 8081
ensurePreviewReachable = "/status"

[userenv]

[userenv.shared]
APPLE_TEAM_ID = "WMJ2XWFP53"
ANDROID_SHA256_FINGERPRINT = "00:7D:2E:5F:97:A0:9D:7C:42:9A:BB:C0:EE:AC:17:7E:8A:2C:C8:E4:0E:6C:59:82:C8:DB:9B:CD:96:90:31:FB,DA:BA:09:0C:C9:99:58:6C:C3:2B:38:FF:01:DE:3F:FD:4A:4F:F7:CE:DE:06:DF:8D:AD:75:8B:9E:6F:47:0D:21"
