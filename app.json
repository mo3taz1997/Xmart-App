{
  "expo": {
    "name": "XMART",
    "slug": "xmart-smart-online-shopping",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xmart",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/c83aec3c-614b-402a-89fa-6371f3ce984f"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.xmart.jo",
      "buildNumber": "10",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["fbapi", "fb-messenger-share-api"]
      }
    },
    "android": {
      "package": "com.xmart.jo",
      "versionCode": 10,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "photosPermission": "Allow Xmart to access your photos to set a profile picture."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier will be used to deliver personalized ads and improve your shopping experience."
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1000504526488987",
          "clientToken": "86d39ac98643ed6efccab93e157ea690",
          "displayName": "XMART",
          "scheme": "fb1000504526488987",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": true,
          "iosUserTrackingPermission": "This identifier will be used to deliver personalized ads and improve your shopping experience."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "c83aec3c-614b-402a-89fa-6371f3ce984f"
      }
    }
  }
}
