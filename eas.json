{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "ecom-manager.replit.app"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "ecom-manager.replit.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
